# Copy this to .env and edit. The app runs fine with no config at all;
# everything here is optional. .env is gitignored so nothing is committed.

# Port for the API (and the single-port production server).
PORT=5180
# The Vite dev client runs on 5179 (see client/vite.config.ts).

# Where the SQLite file lives. Leave unset to use server/data/app.db.
# DB_PATH=server/data/app.db
